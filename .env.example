# ─────────────────────────────────────────────────────────────
# Lead destination — configure AT LEAST ONE option.
# If none is configured, the form honestly tells visitors it is
# not connected yet and suggests calling/emailing instead.
# Copy this file to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# Option A — Webhook (Zapier, Make, n8n, Google Apps Script, a CRM, etc.)
# Every lead is POSTed as JSON to this URL.
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the "X-Lead-Secret" header.
LEAD_WEBHOOK_SECRET=

# Option B — Email via Resend (https://resend.com), no SDK needed.
RESEND_API_KEY=
# Address that receives the leads (Silvia's inbox).
LEAD_EMAIL_TO=
# Verified sender on your domain, e.g. "Website <leads@yourdomain.com>"
LEAD_EMAIL_FROM=

# Set to 1 to make `next build` fail while essential data is pending.
# Vercel production deployments (VERCEL_ENV=production) enforce this automatically.
REQUIRE_LAUNCH_READY=
